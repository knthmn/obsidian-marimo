{
  "name": "obsidian-marimo",
  "version": "0.0.1",
  "description": "Integrating Marimo (https://marimo.io/) for Obsidian (https://obsidian.md)",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "bun esbuild.config.mjs",
    "build": "bun esbuild.config.mjs production",
    "version-bump": "bun version-bump.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "simple-git-hooks"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "5.29.0",
    "@typescript-eslint/parser": "5.29.0",
    "builtin-modules": "3.3.0",
    "esbuild": "0.17.3",
    "eslint": "^9.7.0",
    "lint-staged": "^15.2.7",
    "obsidian": "latest",
    "prettier": "^3.3.3",
    "simple-git-hooks": "^2.11.1",
    "tslib": "2.4.0",
    "typescript": "5.5.3",
    "typescript-eslint": "^7.16.0"
  },
  "simple-git-hooks": {
    "pre-commit": "bun lint-staged"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "{package.json,manifest.json}": [
      "bun version-bump",
      "prettier --write"
    ]
  }
}
